  "model": "poe/kimi-k2.5-fw",
  "provider": {
    "youyun": {
      "options": {
        "baseURL": "https://api.modelverse.cn/v1",
        "apiKey": "{env:YOUYUN_CODING_PLAN_API_KEY}"
      },
      "models": {
        "moonshot/kimi-k2.5": {},
        "glm-5v-turbo": {}
      }
    },
    "poe": {
      "options": {
        "baseURL": "https://api.poe.com/v1",
        "apiKey": "{env:POE_API_KEY}"
      },
      "models": {
        "gpt-5.3-codex-spark": {},
        "kimi-k2.5-fw": {},
        "glm-5-t": {}
      }
    }
  }
}
